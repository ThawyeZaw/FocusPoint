# FocusPoint — Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# The .env file is gitignored — your keys never go to GitHub.
#
# For production deploys on Netlify:
#   Site → Environment variables → add the same two keys below.
#   Netlify injects them at build time. They are NOT stored in Git.
#
# Find your credentials at:
#   Supabase Dashboard → Settings → API
#   - "Project URL" → VITE_SUPABASE_URL
#   - "anon" / "public" key → VITE_SUPABASE_PUBLISHABLE_KEY

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_PUBLIC_KEY
